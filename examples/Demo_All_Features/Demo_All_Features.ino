#include <microWire.h>
#include <Danich_SSD130x_Fast.h>

// Для безбуферного режима (0 байт ОЗУ) используем пустые скобки <>:
Danich_SSD130x_Fast<> myOLED(0x3C);

void setup() {
  myOLED.begin(OLED_1309);   // Для экранов на SSD1306 укажите OLED_1306
  Wire.setClock(600000L);    // Разгон I2C до 600 кГц

  myOLED.setFont(SmallFontRus);

  // --- СЛАЙД 1: Безбуферная графика и масштаб 2x (строго по разным страницам) ---
  myOLED.setScale(2);
  myOLED.print(F("2x \230\220\210\224\222"), OLED_C, 2); // "2x ШРИФТ" в CP866
  myOLED.setScale(1);

  // Три типа горизонтальных линий на разных страницах (стр. 3, 4 и 5)
  myOLED.drawHLine(10, 25, 108);                // Страница 3 (Y=25): сплошная линия
  myOLED.drawHLine(10, 33, 108, 6, 3);          // Страница 4 (Y=33): длинный пунктир (6 и 3)
  myOLED.drawHLine(10, 41, 108, 1, 2);          // Страница 5 (Y=41): точечная линия (1 и 2)

  // Вертикальные пунктирные линии по бокам (X=5 и X=122)
  myOLED.drawVLine(5, 25, 34, 2, 2);
  myOLED.drawVLine(122, 25, 34, 1, 1);

  // Пунктирная рамка внизу (верх Y=47 [стр. 5], низ Y=61 [стр. 7]) + текст на странице 6
  myOLED.drawRect(10, 45, 108, 15, 4, 2);
  myOLED.print(F("\203\340\240\344\250\252\240 0 \216\207\223"), OLED_C, 6); // "Графика 0 ОЗУ"

  delay(4000);

  // --- СЛАЙД 2: Рабочий интерфейс с бегущей строкой ---
  myOLED.clrScr();
  myOLED.print(F("Danich_SSD130x_Fast"), OLED_C, 0);
  myOLED.drawHLine(8, 10, 113, 1 ,1);           // Точечный разделитель под заголовком
  myOLED.drawRect(8, 16, 112, 24, 3, 2);        // Пунктирная рамка для бегущей строки

  myOLED.invText(true);
  myOLED.print(F(" RUN "), 8, 6);
  myOLED.invText(false);

  myOLED.print(F("Ver: "), 52, 6);
  myOLED.printPadZero(200, 3);                  // Выведет "200"
}

void loop() {
  // Автопилот бегущей строки внутри рамки (окно X=10..117)
  // "Быстрая безбуферная бегущая строка!" в восьмеричной кодировке CP866:
  myOLED.printTicker(
      F("\201\353\341\342\340\240\357 \241\245\247\241\343\344\245\340\255\240\357 \241\245\243\343\351\240\357 \341\342\340\256\252\240!"),
      3, 20, 10, 108);
}